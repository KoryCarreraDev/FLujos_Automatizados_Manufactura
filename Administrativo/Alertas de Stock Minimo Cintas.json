    {
      "parameters": {
        "jsCode": "// Recibe los dos ítems del Merge\nconst stocks = {};\nfor (const item of $input.all()) {\n  stocks[item.json.tipo] = item.json.stock;\n}\n\nconst limites = {\n  Seguridad: 40,\n  Resellable: 4\n};\n\nconst alertas = [];\n\nfor (const [tipo, stock] of Object.entries(stocks)) {\n  const min = limites[tipo];\n  if (stock < min) {\n    alertas.push(`⚠️ ${tipo}: ${stock} unidades (mínimo ${min})`);\n  }\n}\n\nconst enviarAlerta = alertas.length > 0;\nconst mensaje = enviarAlerta\n  ? `🔴 ALERTA DE STOCK BAJO\\n\\n${alertas.join('\\n')}\\n\\nRevisar inventario.`\n  : '';\n\nreturn [{\n  json: {\n    enviar: enviarAlerta,\n    mensaje: mensaje,\n    detalles: alertas\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
