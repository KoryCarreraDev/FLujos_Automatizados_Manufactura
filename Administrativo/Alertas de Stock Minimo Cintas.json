    {
      "parameters": {
        "jsCode": "// Extrae el último valor de Stock Restante de Resellable\nconst rows = $input.all().map(item => item.json);\nconst stocks = rows.map(r => parseFloat(r[\"Stock Restante\"])).filter(v => !isNaN(v));\nconst ultimoStock = stocks.length > 0 ? stocks[stocks.length - 1] : 0;\n\nreturn [{\n  json: {\n    tipo: \"Resellable\",\n    stock: ultimoStock\n  }\n}];"
      },
