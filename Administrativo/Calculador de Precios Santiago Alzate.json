      ],
      "id": "7afdc227-4d2b-4704-beb2-cea8968732b9",
      "name": "Leer pedidos comerciales",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "MGhsS3AU1dLzVvBS",
          "name": "Sheets Sistema Beiplas"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const precios = $getWorkflowStaticData('global').precios || {};\n\n// SECRETO: Densidades por material (en g/cm³)\nconst DENSIDADES = {\n  'baja': ej,\n  'alta': ej,\n  'pp': ej,\n  'mahiz': ej\n};\n\n// Costo de aditivo por kilogramo\nconst COSTO_ADITIVO_KG = 1;\n\nconst pedidos = $input.all().map(i => i.json);\nconst resultados = [];\n\nfor (const p of pedidos) {\n  \n  if (p['Precio Unidad'] && String(p['Precio Unidad']).trim() !== '') continue;\n\n  const materialRaw = (p.Material || '').trim();\n  const ancho = parseFloat(p.Ancho);\n  const largo = parseFloat(p.Largo);\n  const calibre = parseFloat(String(p.Calibre).replace(',', '.'));\n  const rowNumber = p.row_number;\n\n  if (!materialRaw || isNaN(ancho) || isNaN(largo) || isNaN(calibre) || rowNumber === undefined) continue;\n\n  const materialLower = materialRaw.toLowerCase();\n  const densidad = DENSIDADES[materialLower];\n  if (densidad === undefined) continue;\n\n  const preciosMat = precios[materialRaw];\n  if (!preciosMat) continue;\n\n  // 1. Peso por bolsa (gramos)\n  const pesoBolsaGramos = ancho * largo * calibre * densidad;\n  // 2. Bolsas por kg (redondeadas a 1 decimal, como en tu cálculo)\n  const bolsasPorKgExactas = 1000 / pesoBolsaGramos;\n  const bolsasPorKg = Math.round(bolsasPorKgExactas * 10) / 10;\n\n  // 3. Precio base por kg (con nuevos descuentos por tipo de recuperado)\n  const tipoRecuperado = (p['Recuperado / Original'] || '').toString().trim().toLowerCase();\n  let baseKg = preciosMat.kiloOriginal;\n\n  if (tipoRecuperado.includes('recuperado')) {\n    if (tipoRecuperado.includes('50')) {\n      baseKg -= preciosMat.descRec50 || 0;          // 50/50\n    } else if (tipoRecuperado.includes('70')) {\n      baseKg -= preciosMat.descRec7030 || 0;        // 70/30\n    } else {\n      baseKg -= preciosMat.descRec100 || 0;         // 100% recuperado\n    }\n  }\n\n  const tintas = parseInt(p.Tintas) || 0;\n  let costoTintasKg = 0;\n  if (materialLower === 'mahiz') {\n    if (tintas > 1) {\n      costoTintasKg = (tintas - 1) * preciosMat.restoTintas;\n    }\n  } else {\n    if (tintas >= 1) {\n      costoTintasKg = preciosMat.unaTinta;\n      if (tintas > 1) {\n        costoTintasKg += (tintas - 1) * preciosMat.restoTintas;\n      }\n    }\n  }\n\n  // Aditivo\n  const conAditivo = (p.Aditivo || '').toString().toLowerCase() === 'si';\n  const aditivoKg = conAditivo ? COSTO_ADITIVO_KG : 0;\n\n  // Troquelado\n  const conTroquelado = (p.Troquelado || '').toString().toLowerCase() === 'si';\n  const troqueladoKg = conTroquelado ? (preciosMat.troquelado || 0) : 0;\n\n  // Precio total por kg\n  const precioKg = baseKg + costoTintasKg + aditivoKg + troqueladoKg;\n\n  // 4. Precio unitario base (sin cinta), truncado a 2 decimales\n  let precioUnidad = precioKg / bolsasPorKg;\n  precioUnidad = Math.floor(precioUnidad * 100) / 100;\n\n  // 5. Cinta (solo una, prioridad seguridad)\n  const cintaSeguridad = (p['Cinta Seguridad'] || '').toString().toLowerCase() === 'si';\n  const cintaResellable = (p['Cinta resellable'] || '').toString().toLowerCase() === 'si';\n  if (cintaSeguridad) {\n    precioUnidad += ancho * (preciosMat.seguridadCm || 0);\n  } else if (cintaResellable) {\n    precioUnidad += ancho * (preciosMat.resellableCm || 0);\n  }\n\n  // 6. Cantidad mínima (Mahiz: 80 kg, otros: 100 kg)\n  const baseMinima = materialLower === 'mahiz' ? 80000 : 100000;\n  const cantidadMinima = Math.ceil(baseMinima / pesoBolsaGramos);\n\n  resultados.push({\n    json: {\n      row_number: rowNumber,\n      'Precio Unidad': Math.round(precioUnidad * 100) / 100,\n      'Cantidad Minima': cantidadMinima\n    }\n  });\n}\n\nif (resultados.length === 0) {\n  return [{ json: { sinCambios: true } }];\n}\n\nreturn resultados;"
      },
