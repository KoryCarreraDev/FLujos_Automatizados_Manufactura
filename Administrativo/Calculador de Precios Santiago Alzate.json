    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst mapaPrecios = {};\n\nfor (const r of rows) {\n  const mat = (r.Material || '').trim();\n  if (!mat) continue;\n\n  const aNumero = (val) => {\n    if (val === undefined || val === null) return 0;\n    if (typeof val === 'number') return val;\n    const str = String(val).replace(/[$,]/g, '');\n    const num = parseFloat(str);\n    return isNaN(num) ? 0 : num;\n  };\n\n  mapaPrecios[mat] = {\n    kiloOriginal: aNumero(r['Kilo Original']),\n    descRec100: aNumero(r['1']),             // 100% recuperado (columna \"1\")\n    descRec50: aNumero(r['50% / 50%']),     // 50/50\n    descRec7030: aNumero(r['70% / 30%']),   // 70% rec / 30% orig\n    unaTinta: aNumero(r['1 tinta']),\n    restoTintas: aNumero(r['Resto de Tintas']),\n    biosphere: aNumero(r['Biosphere']),\n    troquelado: aNumero(r['Troquelado']),\n    seguridadCm: aNumero(r['Seguridad x cm']),\n    resellableCm: aNumero(r['Resellable x cm'])\n  };\n}\n\n$getWorkflowStaticData('global').precios = mapaPrecios;\nreturn [{ json: { ok: true } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -48
      ],
      "id": "81689e1e-a7b2-4cb8-91a8-eb646058ebaa",
      "name": "Mapear precios"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID_CALCULADOR_PRECIOS",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Calculador de Precio",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID_CALCULADOR_PRECIOS/edit#gid=0"
        },
        "options": {}
      },
