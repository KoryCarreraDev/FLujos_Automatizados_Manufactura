    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json;\n  const informada = data['Informada'];\n  \n  // Considerar vacío si es null, undefined, o string vacío/espacios\n  const estaVacia = !informada || String(informada).trim() === '';\n  \n  return {\n    json: {\n      ...data,\n      informar: estaVacia\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "fbce91d3-8e64-4cef-b5a5-71a8c2db97f3",
      "name": "Validar Si Informar"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "237af2d6-32d9-42b7-9bb4-4fac6f831739",
              "leftValue": "={{ $json.informar }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
