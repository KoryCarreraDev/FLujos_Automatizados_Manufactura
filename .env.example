# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=cambia_esta_contrasena_segura
POSTGRES_DB=n8n_db

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
# Puerto en el que n8n sera accesible en el host (el contenedor usa 5678)
N8N_PORT=5678

# Clave de cifrado para las credenciales almacenadas en n8n.
# Genera una con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambia_esta_clave_de_cifrado_aleatoria

# URL publica de tu instancia n8n (usada para webhooks).
# Si usas ngrok: https://<tu-subdominio>.ngrok-free.app/
# Si tienes dominio propio: https://n8n.tu-dominio.com/
N8N_WEBHOOK_URL=https://YOUR_NGROK_OR_DOMAIN_URL/

# -----------------------------------------------------------------------------
# NODE.JS (script runner auxiliar)
# -----------------------------------------------------------------------------
# Puerto en el que el servicio Node.js sera accesible en el host
NODE_PORT=3000

# Entorno de ejecucion de Node (development | production)
NODE_ENV=production

# -----------------------------------------------------------------------------
# OLLAMA (IA local)
# Ollama no requiere variables adicionales en este compose.
# El servicio queda disponible en http://ollama:11434 dentro de la red Docker.
# Para descargar modelos despues de levantar:
#   docker exec -it ollama_automation ollama pull llama3
# -----------------------------------------------------------------------------
