    {
      "parameters": {
        "jsCode": "const pendientes = $input.all().filter(item => \n  item.json['Titulo Referencia'] && item.json['Titulo Referencia'].toString().trim() !== ''\n);\n\nif (pendientes.length === 0) {\n  return [{ json: { mensaje: '', enviar: false } }];\n}\n\n// Colores corporativos\nconst colorPrimario = '#1a365d';   // azul oscuro\nconst colorSecundario = '#2b6cb0'; // azul medio\nconst colorFondo = '#f7fafc';\nconst colorTexto = '#2d3748';\nconst colorBorde = '#e2e8f0';\n\nconst resultados = pendientes.map(item => {\n  const d = item.json;\n  const comercial = d.comercial || 'Desconocido';\n  const ref = d['Titulo Referencia'] || 'Sin ref.';\n  const cliente = d.Cliente || 'N/A';\n  const material = d.Material || '';\n  const medidas = `${d.Ancho || '-'} x ${d.Largo || '-'} x cal.${d.Calibre || '-'}`;\n  const precio = d['Precio Unidad'] ?? 'N/D';\n  const cantidad = d['Cantidad Minima'] ?? 'N/D';\n\n  // Construir HTML\n  const html = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin:0; padding:0; background-color:${colorFondo}; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:${colorFondo}; padding: 20px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n          <!-- Encabezado -->\n          <tr>\n            <td style=\"background-color:${colorPrimario}; padding: 24px 30px; text-align: center;\">\n              <h1 style=\"color:#ffffff; margin:0; font-size: 22px; font-weight: 600;\">Nueva Cotización Registrada</h1>\n            </td>\n          </tr>\n          <!-- Cuerpo -->\n          <tr>\n            <td style=\"padding: 30px 30px 20px 30px;\">\n              <p style=\"margin:0 0 16px 0; font-size: 16px; color:${colorTexto}; line-height: 1.5;\">\n                El comercial <strong style=\"color:${colorSecundario};\">${comercial}</strong> ha registrado una nueva cotización:\n              </p>\n              \n              <!-- Tabla de detalles -->\n              <table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse: collapse; margin-bottom: 20px;\">\n                <tr>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorPrimario}; font-weight:600; width:35%;\">📌 Referencia</td>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorTexto};\">${ref} (Cliente: ${cliente})</td>\n                </tr>\n                <tr>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorPrimario}; font-weight:600;\">• Material</td>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorTexto};\">${material}</td>\n                </tr>\n                <tr>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorPrimario}; font-weight:600;\">• Medidas</td>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorTexto};\">${medidas}</td>\n                </tr>\n                <tr>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorPrimario}; font-weight:600;\">• Precio Unidad</td>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorTexto}; font-weight: 600;\">$${precio}</td>\n                </tr>\n                <tr>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorPrimario}; font-weight:600;\">• Cantidad Mínima</td>\n                  <td style=\"border-bottom:1px solid ${colorBorde}; color:${colorTexto};\">${cantidad} unidades</td>\n                </tr>\n              </table>\n              \n              <p style=\"margin:0 0 16px 0; font-size: 14px; color:#718096;\">\n                Por favor revise en caso de alguna duda o inquietud.\n              </p>\n            </td>\n          </tr>\n          <!-- Pie -->\n          <tr>\n            <td style=\"background-color:${colorFondo}; padding: 16px 30px; text-align: center; border-top: 1px solid ${colorBorde};\">\n              <p style=\"margin:0; font-size: 12px; color:#a0aec0;\">\n                Este mensaje fue generado automáticamente por el sistema de cotizaciones de <strong>Beiplas</strong>.<br>\n                Si tiene alguna duda, contacte al administrador.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n\n  return {\n    json: {\n      mensaje: html,\n      comercial,\n      documento_id: d.documento_id,\n      row_number: d.row_number,\n      _notificar: true\n    }\n  };\n});\n\nreturn resultados;"
      },
