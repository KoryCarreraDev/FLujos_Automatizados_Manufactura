    {
      "parameters": {
        "jsCode": "const loopItem = $('Loop Over Items').item.json;\nconst comercial = loopItem?.comercial || 'Desconocido';\nconst documentoId = loopItem?.id || '';\n\n// Campos obligatorios para considerar una cotización completa\nconst camposObligatorios = ['Titulo Referencia', 'Material', 'Ancho', 'Largo', 'Calibre'];\n\nconst resultados = $input.all().map(item => {\n  const data = { ...item.json };\n  const informada = data['Informada (Automatico)']\n    ? data['Informada (Automatico)'].toString().trim().toUpperCase()\n    : '';\n\n  // Verificar completitud\n  const completa = camposObligatorios.every(campo =>\n    data[campo] !== undefined && data[campo] !== null && String(data[campo]).trim() !== ''\n  );\n\n  // Solo se notifica si NO está informada y está completa\n  const notificar = informada !== 'SI' && completa;\n\n  return {\n    json: {\n      ...data,\n      comercial: comercial,\n      documento_id: documentoId,\n      _notificar: notificar\n    }\n  };\n});\n\n// Si no hay ningún resultado (hoja vacía), devolvemos marcador para que el flujo no se detenga\nif (resultados.length === 0) {\n  return [{ json: { _notificar: false, comercial, documento_id: documentoId } }];\n}\n\nreturn resultados;"
      },
