      "parameters": {
        "jsCode": "const hojas = [];\nfor (let i = 1; i <= 9; i++) hojas.push({ hoja: `Selladora ${i}` });\nfor (let i = 1; i <= 9; i++) hojas.push({ hoja: `Extrusora ${i}` });\nhojas.push({ hoja: \"Impresora 1\" });\nhojas.push({ hoja: \"Impresora 2\" });\nhojas.push({ hoja: \"Troqueladora 1\" });\nhojas.push({ hoja: \"Troqueladora 2\" });\nreturn hojas.map(item => ({ json: item }));"
