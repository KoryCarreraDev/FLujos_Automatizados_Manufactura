    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1120,
        272
      ],
      "id": "8232d691-024d-4b4f-95f4-a14fed44ec74",
      "name": "Merge preventivas + novedades"
    },
    {
      "parameters": {
        "jsCode": "const hoy = new Date();\nhoy.setHours(0, 0, 0, 0);\n\nfunction norm(str) {\n  return String(str || '')\n    .trim()\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '');\n}\n\nconst consolidado = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n  const tipo = d.tipoTarea;\n  const estadoRaw = d.estado;\n  const estado = norm(estadoRaw);\n  const semaforo = d.semaforo || '';\n\n  // Calcular Vencida solo si está pendiente\n  let vencida = 'Pendientes';\n  if (estado === 'pendiente') {\n    if (tipo === 'Preventiva') {\n      const fechaStr = d.ultimaRevision;\n      const frec = parseInt(d.frecuenciaDias, 10);\n      if (fechaStr && !isNaN(frec)) {\n        const partes = fechaStr.split('/');\n        if (partes.length === 3) {\n          const fechaRev = new Date(partes[2], partes[1] - 1, partes[0]);\n          if (!isNaN(fechaRev.getTime())) {\n            fechaRev.setDate(fechaRev.getDate() + frec);\n            if (fechaRev <= hoy) vencida = 'Sí';\n          }\n        }\n      }\n    } else if (tipo === 'Correctiva') {\n      const fechaEstStr = d.fechaEstimada;\n      if (fechaEstStr) {\n        const partes = fechaEstStr.split('/');\n        if (partes.length === 3) {\n          const fechaEst = new Date(partes[2], partes[1] - 1, partes[0]);\n          if (!isNaN(fechaEst.getTime()) && fechaEst < hoy) vencida = 'Vencida';\n        }\n      }\n    }\n  }\n\n  // Insertar siempre (sin filtrar)\n  consolidado.push({\n    maquina: d.hoja || d.maquina || '',\n    tipoTarea: tipo || '',\n    tarea: d.tareas || '',\n    estado: estadoRaw || '',                // guardamos el valor original\n    semaforo: semaforo,\n    responsable: d.responsable || '',\n    frecuencia: d.frecuenciaDias || '',\n    ultimaRevision: d.ultimaRevision || '',\n    vencida: vencida,\n    fechaCreacion: d.fechaCreacion || '',\n    fechaEstimada: d.fechaEstimada || '',\n    observaciones: d.observaciones || ''\n  });\n}\n\nreturn consolidado.map(c => ({ json: c }));"
      },
