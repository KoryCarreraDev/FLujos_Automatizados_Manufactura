    {
      "parameters": {
        "jsCode": "const hoja = $('Loop Over Items (hojas preventivas)').item.json.hoja;\nconst filas = $input.all();\nif (filas.length === 0) return [];\n\nfunction normalizarClave(str) {\n  return str.trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/['´`]/g, '').replace(/\\s+/g, '');\n}\n\nconst mapeo = {\n  'tareas/procesos': 'tareas',\n  'ultimarevision': 'ultimaRevision',\n  'frecuencia(dias)': 'frecuenciaDias',\n  'semaforo': 'semaforo',\n  'estado(pendiente/cumplida)': 'estado',\n  'nombreresponsable/s': 'responsable',\n  'ultimasobservaciones': 'observaciones',\n  'rownumber': 'row_number'\n};\n\nreturn filas.map(item => {\n  const raw = item.json;\n  const normalizado = {};\n  if (raw.row_number !== undefined) normalizado.row_number = raw.row_number;\n  for (const key of Object.keys(raw)) {\n    const claveNorm = normalizarClave(key);\n    const estandar = mapeo[claveNorm];\n    normalizado[estandar || key] = raw[key];\n  }\n  normalizado.hoja = hoja;\n  normalizado.tipoTarea = 'Preventiva';\n  return { json: normalizado };\n});"
      },
      "type": "n8n-nodes-base.code",
