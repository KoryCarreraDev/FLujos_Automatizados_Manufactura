    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    hoja: 'Novedades',\n    maquina: item.json['Maquina'] || '',\n    tipoTarea: 'Correctiva',\n    tareas: item.json['Observaciones respecto a la novedad (Obligatorio)'] || '',\n    estado: item.json['Estado (Solo Mantenimiento)'] || '',\n    semaforo: item.json['Semaforo (automatico)'] || '',\n    frecuenciaDias: '',\n    ultimaRevision: '',\n    responsable: item.json['Quien creó la novedad (Solo nombre)'] || '',\n    observaciones: item.json['Observaciones respecto a la novedad (Obligatorio)'] || '',\n    fechaEstimada: item.json['Fecha estimada de solución (Solo Mantenimiento)'] || '',\n    fechaCreacion: item.json['Fecha de creacion (automatico)'] || ''\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
