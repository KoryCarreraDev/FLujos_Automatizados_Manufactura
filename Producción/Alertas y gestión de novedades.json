    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst maquina = data['Maquina'] || 'No especificada';\nconst creador = data['Quien creó la novedad (Solo nombre)'] || 'No registrado';\nconst observaciones = data['Observaciones respecto a la novedad (Obligatorio)'] || 'Sin observaciones';\nconst fechaCreacion = data['Fecha de creacion'] || '';\nconst fechaEstimada = data['Fecha estimada de solución (Solo Mantenimiento)'] || 'No definida';\nconst fechaSolucion = data['Fecha Solución'] || new Date().toLocaleDateString('es-CO');\nconst semaforo = data['Semaforo'] || 'Gris';\nconst colorCabecera = semaforo === 'Rojo' ? '#dc3545' : semaforo === 'Naranja' ? '#fd7e14' : '#28a745';\nconst iconoSemaforo = semaforo === 'Rojo' ? '🔴' : semaforo === 'Naranja' ? '🟠' : '🟢';\n\nconst html = `\n<div style=\"font-family: Arial, sans-serif; max-width: 650px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 10px; overflow: hidden;\">\n  <div style=\"background: ${colorCabecera}; padding: 25px; text-align: center;\">\n    <h2 style=\"color: white; margin: 0; font-size: 22px;\">✅ Novedad Cumplida / Cerrada</h2>\n    <p style=\"color: rgba(255,255,255,0.9); margin: 10px 0 0 0; font-size: 14px;\">Solucionada el ${fechaSolucion}</p>\n  </div>\n  <div style=\"padding: 30px; background: #ffffff;\">\n    <p style=\"font-size: 15px; color: #555; line-height: 1.6;\">\n      Estimado <strong>Supervisor</strong>,<br>\n      Se ha cerrado la siguiente novedad de mantenimiento:\n    </p>\n    <div style=\"background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;\">\n      <table style=\"width: 100%; border-collapse: collapse;\">\n        <tr>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666; width: 40%;\"><strong>🏭 Máquina:</strong></td>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333; font-weight: bold;\">${maquina.toUpperCase()}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666;\"><strong>👤 Creada por:</strong></td>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333;\">${creador}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666;\"><strong>📝 Novedad:</strong></td>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333; font-style: italic;\">${observaciones}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666;\"><strong>📅 Fecha creación:</strong></td>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333;\">${fechaCreacion}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666;\"><strong>📅 Fecha estimada solución:</strong></td>\n          <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333;\">${fechaEstimada}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 10px 5px; color: #666;\"><strong>✅ Fecha de solución:</strong></td>\n          <td style=\"padding: 10px 5px; color: #333;\">${fechaSolucion}</td>\n        </tr>\n      </table>\n    </div>\n    <p style=\"font-size: 14px; color: #777;\">\n      Esta novedad fue atendida y registrada en el historial. Por favor revise si requiere seguimiento adicional.\n    </p>\n  </div>\n  <div style=\"background: #f1f3f5; padding: 20px; text-align: center; border-top: 1px solid #dee2e6;\">\n    <p style=\"font-size: 12px; color: #888; margin: 0;\">\n      🔧 Sistema Automatizado de Gestión de Mantenimiento<br>\n      <span style=\"font-size: 11px;\">Este correo fue generado automáticamente. Por favor no responda a este mensaje.</span>\n    </p>\n  </div>\n</div>\n`;\n\nreturn [{ json: { html, asunto: `✅ Novedad de mantenimiento CERRADA - ${maquina.toUpperCase()}` } }];"
      },
