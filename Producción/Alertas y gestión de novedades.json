    {
      "parameters": {
        "sendTo": "example@example.com",
        "subject": "={{ (() => { const maquina = $('Procesar Novedad').item.json.Maquina || 'Sin máquina'; const icono = $json['Semaforo (automatico)'] === 'rojo' ? '🔴' : $json['Semaforo (automatico)'] === 'naranja' ? '🟠' : '🟢'; return `${icono} Nueva novedad registrada - ${maquina}`; })() }}",
        "message": "={{ (() => {\n  const maquina = $('Procesar Novedad').item.json.Maquina || 'No especificada';\n  const estado = $('Procesar Novedad').item.json['Estado (Solo Mantenimiento)'] || 'pendiente';\n  const semaforo = $('Procesar Novedad').item.json['Semaforo (automatico)'] || 'verde';\n  const creador = $('Procesar Novedad').item.json['Quien creó la novedad (Solo nombre)'] || 'No registrado';\n  const observaciones = $('Procesar Novedad').item.json['Observaciones respecto a la novedad (Obligatorio)'] || 'Sin observaciones';\n  const fechaCreacion = $json['Fecha de creacion (automatico)'] || new Date().toLocaleDateString('es-CO');\n  const fechaEstimada = $('Procesar Novedad').item.json['Fecha estimada de solución (Solo Mantenimiento)'] || 'No definida';\n  const color = semaforo === 'rojo' ? '#dc3545' : semaforo === 'naranja' ? '#fd7e14' : '#28a745';\n  const icono = semaforo === 'rojo' ? '🔴' : semaforo === 'naranja' ? '🟠' : '🟢';\n  let mensajeAccion = '';\n  if (semaforo === 'rojo') {\n    mensajeAccion = '<p style=\"color: #dc3545; font-weight: bold;\">⚠️ Esta novedad requiere atención inmediata. La fecha estimada está vencida o muy cercana.</p>';\n  } else if (semaforo === 'naranja') {\n    mensajeAccion = '<p style=\"color: #fd7e14; font-weight: bold;\">⚠️ Esta novedad debe ser atendida en los próximos días.</p>';\n  } else {\n    mensajeAccion = '<p style=\"color: #28a745;\">✅ Esta novedad está dentro del tiempo estimado. Programe su atención.</p>';\n  }\n  return `\n  <div style=\"font-family: Arial, sans-serif; max-width: 650px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 10px; overflow: hidden;\">\n    <div style=\"background: ${color}; padding: 25px; text-align: center;\">\n      <h2 style=\"color: white; margin: 0; font-size: 22px;\">${icono} Nueva Novedad de Mantenimiento</h2>\n      <p style=\"color: rgba(255,255,255,0.9); margin: 10px 0 0 0; font-size: 14px;\">Registrada el ${fechaCreacion}</p>\n    </div>\n    <div style=\"padding: 30px; background: #ffffff;\">\n      <p style=\"font-size: 16px; color: #333; margin-top: 0;\">Estimado <strong>Jefe de Mantenimiento</strong>,</p>\n      <p style=\"font-size: 15px; color: #555; line-height: 1.6;\">Se ha registrado una nueva novedad en el sistema que requiere su atención y programación.</p>\n      ${mensajeAccion}\n      <div style=\"background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n          <tr>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666; width: 40%;\"><strong>🏭 Máquina:</strong></td>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333; font-weight: bold;\">${maquina.toUpperCase()}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666;\"><strong>📊 Estado:</strong></td>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333;\"><span style=\"background: ${color}; color: white; padding: 4px 12px; border-radius: 12px; font-size: 13px; font-weight: bold;\">${estado.toUpperCase()}</span></td>\n          </tr>\n          <tr>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666;\"><strong>🚦 Semáforo:</strong></td>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333; font-weight: bold;\">${icono} ${semaforo.toUpperCase()}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666;\"><strong>👤 Reportado por:</strong></td>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333;\">${creador}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #666;\"><strong>📅 Fecha estimada:</strong></td>\n            <td style=\"padding: 10px 5px; border-bottom: 1px solid #dee2e6; color: #333;\">${fechaEstimada}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 10px 5px; color: #666; vertical-align: top;\"><strong>📝 Observaciones:</strong></td>\n            <td style=\"padding: 10px 5px; color: #333; font-style: italic;\">${observaciones}</td>\n          </tr>\n        </table>\n      </div>\n      <p style=\"font-size: 15px; color: #555; line-height: 1.6;\">Por favor, coordine con el personal técnico para atender esta novedad según su criticidad y actualice el estado una vez solucionada.</p>\n    </div>\n    <div style=\"background: #f1f3f5; padding: 20px; text-align: center; border-top: 1px solid #dee2e6;\">\n      <p style=\"font-size: 12px; color: #888; margin: 0;\">\n        🔧 Sistema Automatizado de Gestión de Mantenimiento<br>\n        <span style=\"font-size: 11px;\">Este correo fue generado automáticamente. Por favor no responda a este mensaje.</span>\n      </p>\n    </div>\n  </div>\n  `;\n})() }}",
        "options": {
          "appendAttribution": false,
          "bccList": "example@example.com, example@example.com",
          "ccList": "example@example.com, example@example.com"
        }
      },
