{
  "name": "Alertas y gestión de novedades",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Funciones auxiliares de fecha\nfunction parsearFechaLatam(fechaStr) {\n  if (!fechaStr || typeof fechaStr !== 'string') return null;\n  // Aceptar tanto \"dd/mm/aaaa\" como \"dd-mm-aaaa\"\n  const fechaNormalizada = fechaStr.replace(/-/g, '/');\n  const partes = fechaNormalizada.split('/');\n  if (partes.length !== 3) return null;\n  return new Date(parseInt(partes[2], 10), parseInt(partes[1], 10) - 1, parseInt(partes[0], 10));\n}\n\nfunction formatearFechaLatam(date) {\n  return String(date.getDate()).padStart(2, '0') + '/' + String(date.getMonth() + 1).padStart(2, '0') + '/' + date.getFullYear();\n}\n\nconst hoy = new Date();\nhoy.setHours(0, 0, 0, 0);\nconst resultados = [];\n\n// Determinar si el evento es de \"Disparador Nueva Novedad\" (nuevas filas) de forma segura\nlet esNuevaNovacion = false;\ntry {\n  esNuevaNovacion = $('Disparador Nueva Novedad').first().json ? true : false;\n} catch (e) {\n  esNuevaNovacion = false;\n}\n\nfor (const item of $input.all()) {\n  const data = { ...item.json };\n\n  // Normalizar a minúsculas (excepto fechas y la columna de informada)\n  for (const key of Object.keys(data)) {\n    if (\n      typeof data[key] === 'string' &&\n      key !== 'Fecha estimada de solución (Solo Mantenimiento)' &&\n      key !== 'Fecha de creacion (automatico)' &&\n      key !== '¿Informada? (Automatico)'\n    ) {\n      data[key] = data[key].toLowerCase();\n    }\n  }\n\n  // Valores por defecto\n  if (!data['Estado (Solo Mantenimiento)'] || data['Estado (Solo Mantenimiento)'].trim() === '') {\n    data['Estado (Solo Mantenimiento)'] = 'pendiente';\n  }\n\n  if (!data['Fecha de creacion (automatico)'] || data['Fecha de creacion (automatico)'].trim() === '') {\n    data['Fecha de creacion (automatico)'] = formatearFechaLatam(hoy);\n  }\n\n  // Normalizar la fecha estimada: convertir guiones a barras y eliminar espacios\n  let fechaEstimadaStr = data['Fecha estimada de solución (Solo Mantenimiento)'];\n  if (fechaEstimadaStr && typeof fechaEstimadaStr === 'string') {\n    fechaEstimadaStr = fechaEstimadaStr.trim().replace(/-/g, '/');\n  }\n\n  // Semáforo automático\n  let nuevoSemaforo = 'Gris';   // Valor por defecto cuando no hay fecha\n\n  if (fechaEstimadaStr && fechaEstimadaStr !== '') {\n    const fechaEstimada = parsearFechaLatam(fechaEstimadaStr);\n\n    if (fechaEstimada && !isNaN(fechaEstimada)) {\n      const diffTime = fechaEstimada.getTime() - hoy.getTime();\n      const diasRestantes = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\n      if (diasRestantes <= 2) {\n        nuevoSemaforo = 'Rojo';\n      } else if (diasRestantes <= 4) {\n        nuevoSemaforo = 'Naranja';\n      } else {\n        nuevoSemaforo = 'Verde';\n      }\n    }\n  }\n\n  data['Semaforo (automatico)'] = nuevoSemaforo;\n\n  // ¿Está informada?\n  const informadaRaw = data['¿Informada? (Automatico)'];\n\n  const yaInformada =\n    informadaRaw &&\n    informadaRaw\n      .trim()\n      .toLowerCase()\n      .normalize('NFD')\n      .replace(/[\\u0300-\\u036f]/g, '') === 'si';\n\n  // Clave de fila\n  const rowKey = item.json.row_number || data['ID'] || null;\n\n  // NORMALIZAR ESTADO PARA EVITAR CASE SENSITIVE\n  const estado = (\n    data['Estado (Solo Mantenimiento)'] || ''\n  )\n    .trim()\n    .toLowerCase();\n\n  // Cumplida y Cerrada hacen exactamente lo mismo\n  if (['cumplida', 'cerrada'].includes(estado)) {\n\n    resultados.push({\n      json: {\n        tipo: 'historial',\n        Fecha: formatearFechaLatam(hoy),\n        'Máquina': data['Maquina'] || '',\n        'Responsable': data['Quien creó la novedad (Solo nombre)'] || '',\n        'Novedad': data['Observaciones respecto a la novedad (Obligatorio)'] || '',\n        'Fecha creación': data['Fecha de creacion (automatico)'],\n        'Fecha solución': fechaEstimadaStr || '',   // Ya viene normalizada con /\n        'Semaforo final': nuevoSemaforo,\n        'Observaciones': data['Observaciones respecto a la novedad (Obligatorio)'] || ''\n      }\n    });\n\n    if (rowKey) {\n      resultados.push({\n        json: {\n          tipo: 'delete',\n          key: rowKey\n        }\n      });\n    }\n\n  } else {\n\n    resultados.push({\n      json: {\n        tipo: 'update',\n        key: rowKey,\n        ...data,\n        // Si la fecha estimada fue normalizada, reemplazamos en data para que se propague con barras\n        'Fecha estimada de solución (Solo Mantenimiento)': fechaEstimadaStr,\n        enviarCorreo: esNuevaNovacion && !yaInformada\n      }\n    });\n\n  }\n}\n\nif (resultados.length === 0) {\n  resultados.push({\n    json: {\n      tipo: 'vacio'\n    }\n  });\n}\n\nreturn resultados;"
      },
