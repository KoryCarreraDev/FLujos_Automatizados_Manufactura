      "id": "2f8a5305-11a4-436c-bce6-8db9bbf65998",
      "name": "Leer hoja",
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "MGhsS3AU1dLzVvBS",
          "name": "Sheets Sistema Beiplas"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const hoja = $('Loop Over Items').item.json.hoja;\nconst filas = $input.all();\n\n// Devolvemos un único ítem especial para hojas sin datos\nif (filas.length === 0) {\n  return [{ json: { hoja: hoja, _vacia: true, _skip: true } }];\n}\n\nfunction normalizarClave(str) {\n  return str\n    .trim()\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/['´`]/g, '')\n    .replace(/\\s+/g, '');\n}\n\nconst mapeo = {\n  'tareas/procesos': 'tareas',\n  'ultimarevision': 'ultimaRevision',\n  'frecuencia(dias)': 'frecuenciaDias',\n  'semaforo': 'semaforo',\n  'estado(pendiente/cumplida)': 'estado',\n  'nombreresponsable/s': 'responsable',\n  'ultimasobservaciones': 'observaciones',\n  'rownumber': 'row_number'\n};\n\nreturn filas.map(item => {\n  const raw = item.json;\n  const normalizado = {};\n  if (raw.row_number !== undefined) {\n    normalizado.row_number = raw.row_number;\n  }\n  for (const key of Object.keys(raw)) {\n    const claveNorm = normalizarClave(key);\n    const estandar = mapeo[claveNorm];\n    if (estandar) {\n      normalizado[estandar] = raw[key];\n    } else {\n      normalizado[key] = raw[key];\n    }\n  }\n  normalizado.hoja = hoja;\n  return { json: normalizado };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1504,
        -256
      ],
      "id": "1eaa1a63-f78a-42af-9bc0-6a8a8ce47104",
      "name": "Normalizar columnas y agregar hoja"
    },
    {
      "parameters": {
        "jsCode": "const hoy = new Date();\nconst ayer = new Date(hoy);\nayer.setDate(ayer.getDate() - 1);\nconst diaA = String(ayer.getDate()).padStart(2, '0');\nconst mesA = String(ayer.getMonth() + 1).padStart(2, '0');\nconst anioA = ayer.getFullYear();\nconst fechaAyer = `${diaA}/${mesA}/${anioA}`;\n\nconst completados = ['cumplido', 'cumplida', 'lista', 'listo', 'hecha', 'hecho', 'null', ''];\n\nfunction normalizarTexto(str) {\n  return String(str)\n    .trim()\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/['´`]/g, '');\n}\n\nreturn $input.all().map(item => {\n  const data = { ...item.json };\n  const estadoRaw = data.estado || '';\n  const estadoNorm = normalizarTexto(estadoRaw);\n\n  // Inicializamos el flag de cambio\n  data._changed = false;\n\n  if (completados.includes(estadoNorm)) {\n    data.ultimaRevision = fechaAyer;\n    data.estado = 'Pendiente';\n    data._changed = true;        // marcamos que esta fila debe actualizarse\n  }\n\n  return { json: data };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1280,
        -288
      ],
      "id": "92246b09-2c88-40c3-a008-64d54dd14d9c",
      "name": "Reiniciar cumplidas (fecha ayer)"
    },
    {
      "parameters": {
        "jsCode": "const hoy = new Date();\nhoy.setHours(0, 0, 0, 0);\n\nfunction normalizarTexto(str) {\n  return String(str)\n    .trim()\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/['´`]/g, '');\n}\n\nreturn $input.all().map(item => {\n  const data = { ...item.json };\n  const estadoRaw = data.estado || '';\n  const estado = normalizarTexto(estadoRaw);\n\n  if (estado === 'pendiente') {\n    let fechaStr = data.ultimaRevision;\n    const frecuenciaRaw = data.frecuenciaDias;\n    const frecuencia = parseInt(frecuenciaRaw, 10);\n\n    let nuevoSemaforo = null;\n\n    if (!fechaStr || typeof fechaStr !== 'string' || fechaStr.trim() === '' || isNaN(frecuencia) || frecuencia <= 0) {\n      nuevoSemaforo = 'Gris';\n    } else {\n      fechaStr = fechaStr.replace(/[-_.]/g, '/');\n      const partes = fechaStr.split('/');\n      if (partes.length === 3) {\n        const dia = parseInt(partes[0], 10);\n        const mes = parseInt(partes[1], 10) - 1;\n        const anio = parseInt(partes[2], 10);\n        const fechaRevision = new Date(anio, mes, dia);\n\n        if (!isNaN(fechaRevision.getTime())) {\n          fechaRevision.setHours(0, 0, 0, 0);\n          const fechaLimite = new Date(fechaRevision);\n          fechaLimite.setDate(fechaLimite.getDate() + frecuencia);\n          const diffTime = fechaLimite - hoy;\n          const diasRestantes = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\n          if (diasRestantes <= 2) {\n            nuevoSemaforo = 'Rojo';\n          } else if (diasRestantes <= 4) {\n            nuevoSemaforo = 'Naranja';\n          } else {\n            nuevoSemaforo = 'Verde';\n          }\n\n          // Normalizar fecha\n          data.ultimaRevision = `${dia.toString().padStart(2, '0')}/${(mes + 1).toString().padStart(2, '0')}/${anio}`;\n        } else {\n          nuevoSemaforo = 'Gris';\n        }\n      } else {\n        nuevoSemaforo = 'Gris';\n      }\n    }\n\n    // Solo actualizamos y marcamos cambio si el semáforo calculado difiere del original\n    if (nuevoSemaforo !== null && data.semaforo !== nuevoSemaforo) {\n      data.semaforo = nuevoSemaforo;\n      data._changed = true;\n    }\n  }\n\n  return { json: data };\n});"
      },
