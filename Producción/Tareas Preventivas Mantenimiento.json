    {
      "parameters": {
        "jsCode": "const hojas = [];\nfor (let i = 1; i <= 9; i++) hojas.push({ hoja: `Selladora ${i}` });\nfor (let i = 1; i <= 9; i++) hojas.push({ hoja: `Extrusora ${i}` });\nfor (let i = 1; i <= 2; i++) hojas.push({ hoja: `Impresora ${i}` });\nfor (let i = 1; i <= 2; i++) hojas.push({ hoja: `Troqueladora ${i}` });\nreturn hojas.map(nombre => ({ json: nombre }));"
      },
