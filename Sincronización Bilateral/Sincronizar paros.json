      "parameters": {
        "jsCode": "const idsProcesados = $getWorkflowStaticData('global').parosMaquinaProcesadas || [];\nif (idsProcesados.length === 0) {\n  return [{ json: { sql: null } }];\n}\nconst lista = idsProcesados.map(id => `'${String(id).replace(/'/g, \"''\")}'`).join(', ');\nconst sql = `DELETE FROM public.paros_maquina WHERE legacy_id NOT IN (${lista})`;\nreturn [{ json: { sql } }];"
