    {
      "parameters": {
        "jsCode": "const loteItems = $input.all().map(item => item.json);\nconst mapMaquinas = $getWorkflowStaticData('global').mapeoMaquinas || {};\n\nconst escape = (v) => String(v).replace(/'/g, \"''\");\nconst formatTimestamp = (fechaStr) => {\n  if (!fechaStr) return 'NULL';\n  const partes = fechaStr.split(' ');\n  const fecha = partes[0];\n  const hora = partes[1] || '00:00:00';\n  const [d, m, a] = fecha.split('/');\n  if (!d || !m || !a) return 'NULL';\n  return `'${a}-${m.padStart(2, '0')}-${d.padStart(2, '0')} ${hora}'`;\n};\nconst parseNumber = (val) => {\n  if (val === undefined || val === null || val === '') return 'NULL';\n  const num = parseFloat(String(val).replace(',', '.'));\n  return isNaN(num) ? 'NULL' : num;\n};\n\nconst validItems = [];\nconst errores = [];\n\nfor (const item of loteItems) {\n  const legacyId = item.ID_ParoMaquina;\n  if (!legacyId) continue;   // sin ID de paro, no se puede hacer nada\n\n  const codigoMaquina = item.Maquina_ParoMaquina?.trim();\n  const idMaquina = mapMaquinas[codigoMaquina];\n\n  if (!idMaquina) {\n    // Guardamos el registro problemático para revisión posterior\n    errores.push({\n      legacyId,\n      codigoMaquina: codigoMaquina || '(vacío)',\n      motivo: item.Motivo_ParoMaquina\n    });\n    continue;   // ← omitimos este paro en el INSERT\n  }\n\n  const tiempoLegacyId = item.IDTiempo_ParoMaquina ? `'${escape(item.IDTiempo_ParoMaquina)}'` : 'NULL';\n  const fechaInicio = formatTimestamp(item.Inicio_ParoMaquina);\n  const fechaFin = formatTimestamp(item.Fin_ParoMaquina);\n  const motivo = item.Motivo_ParoMaquina ? `'${escape(item.Motivo_ParoMaquina)}'` : 'NULL';\n  const categoria = item.Categoria_ParoMaquina ? `'${escape(item.Categoria_ParoMaquina)}'` : 'NULL';\n  const duracion = parseNumber(item.Duracion_ParoMaquina);\n\n  validItems.push(\n    `('${escape(legacyId)}', ${tiempoLegacyId}, ${idMaquina}, ${fechaInicio}, ${fechaFin}, ${motivo}, ${categoria}, ${duracion})`\n  );\n}\n\n// Si hay errores, los devolvemos en un item separado para que puedas verlos en la ejecución\nif (errores.length > 0) {\n  console.log('Paros sin mapeo de máquina:', JSON.stringify(errores));\n}\n\nif (validItems.length === 0) {\n  return [{\n    json: {\n      sql: '',\n      status: 'sin_datos_validos',\n      mensaje: 'Ningún registro tenía un mapeo de máquina válido.',\n      errores\n    }\n  }];\n}\n\nconst sql = `INSERT INTO public.paros_maquina \n  (legacy_id, legacy_tiempo_id, id_maquina, fecha_inicio, fecha_fin, motivo, categoria, duracion_horas)\nVALUES ${validItems.join(', ')}\nON CONFLICT (legacy_id) DO UPDATE SET\n  legacy_tiempo_id = EXCLUDED.legacy_tiempo_id,\n  id_maquina = EXCLUDED.id_maquina,\n  fecha_inicio = EXCLUDED.fecha_inicio,\n  fecha_fin = EXCLUDED.fecha_fin,\n  motivo = EXCLUDED.motivo,\n  categoria = EXCLUDED.categoria,\n  duracion_horas = EXCLUDED.duracion_horas;`;\n\nreturn [{ json: { sql, errores: errores.length ? errores : [] } }];"
      },
