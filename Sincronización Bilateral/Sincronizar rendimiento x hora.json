    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\nconst values = [];\n\nfor (const item of items) {\n  // Selladoras\n  if (item.SELLADO && item.SELLADO.trim() !== '') {\n    const nombre = item.SELLADO.trim();\n    const kgHora = parseFloat(item['HORAS SELLADO']) || 0;\n    values.push(`('${nombre.replace(/'/g, \"''\")}', ${kgHora.toFixed(2)})`);\n  }\n  // Extrusoras\n  if (item.EXTRUSORA && item.EXTRUSORA.trim() !== '') {\n    const nombre = item.EXTRUSORA.trim();\n    const kgHora = parseFloat(item['HORA EXTRUSION']) || 0;\n    values.push(`('${nombre.replace(/'/g, \"''\")}', ${kgHora.toFixed(2)})`);\n  }\n  // Impresoras\n  if (item.IMPRESION && item.IMPRESION.trim() !== '') {\n    const nombre = item.IMPRESION.trim();\n    const kgHora = parseFloat(item['HORA IMPRESION']) || 0;\n    values.push(`('${nombre.replace(/'/g, \"''\")}', ${kgHora.toFixed(2)})`);\n  }\n}\n\nif (values.length === 0) {\n  return [{ json: { sql: '', status: 'sin_datos' } }];\n}\n\nconst sql = `INSERT INTO public.maquinas (nombre, kg_hora)\nVALUES ${values.join(', ')}\nON CONFLICT (nombre) DO UPDATE SET\n  kg_hora = EXCLUDED.kg_hora;`;\n\nreturn [{ json: { sql } }];"
      },
