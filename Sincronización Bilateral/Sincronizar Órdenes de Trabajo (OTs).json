    {
      "parameters": {
        "jsCode": "function convertirFechaLatam(fechaStr) {\n  if (!fechaStr || typeof fechaStr !== 'string' || fechaStr.trim() === '') return null;\n  const partes = fechaStr.trim().split(' ');\n  const fecha = partes[0];\n  const hora = partes[1] || '00:00:00';\n  const [d, m, a] = fecha.split('/');\n  if (!d || !m || !a) return null;\n  return `${a}-${m.padStart(2, '0')}-${d.padStart(2, '0')} ${hora}`;\n}\n\nreturn $input.all().map(item => {\n  const data = { ...item.json };\n  const camposFecha = ['FechaDeEntrega_OrdenTrabajo', 'Fecha_OrdenTrabajo', 'Creado_OrdenTrabajo', 'Modificado_OrdenTrabajo'];\n  for (const campo of camposFecha) {\n    if (data[campo] === undefined || data[campo] === null || data[campo] === '') {\n      data[campo] = null;\n    } else {\n      data[campo] = convertirFechaLatam(data[campo]);\n    }\n  }\n  return { json: data };\n});"
      },
