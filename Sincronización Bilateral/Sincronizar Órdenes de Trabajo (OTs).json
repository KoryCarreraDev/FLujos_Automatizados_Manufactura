      "parameters": {
        "jsCode": "const idsProcesados = $getWorkflowStaticData('global').ordenesTrabajoProcesadas || [];\nif (idsProcesados.length === 0) {\n  return [{ json: { sql: null } }];\n}\nconst lista = idsProcesados.map(id => `'${String(id).replace(/'/g, \"''\")}'`).join(', ');\nconst sql = `DELETE FROM public.ordenes_trabajo WHERE legacy_id NOT IN (${lista})`;\nreturn [{ json: { sql } }];"
