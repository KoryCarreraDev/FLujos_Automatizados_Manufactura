    {
      "parameters": {
        "jsCode": "// Obtenemos el nombre de la hoja desde el primer ítem del loop\nconst hoja = $('Loop Over Items').first().json.hoja || '';\n\n// Determinamos el tipo de movimiento según la hoja\nlet tipoMovimiento = 'Desconocido';\nconst hojaLower = hoja.toLowerCase();\nif (hojaLower.includes('ingreso de cintas')) {\n  tipoMovimiento = 'Ingreso';\n} else if (hojaLower.includes('egresos de cintas')) {\n  tipoMovimiento = 'Egreso';\n}\n\nconst resultados = $input.all().map(item => {\n  const data = item.json;\n\n  // CORRECCIÓN: Evaluación individual por cada fila\n  const reportada = data.Reportada || '';\n  let ingresarInventario = true;\n\n  if (reportada.includes(\"SI\")) {\n    ingresarInventario = false;\n  }\n\n  // Extraer fecha y hora de \"Marca temporal\"\n  const marcaTemporal = data['Marca temporal'] || '';\n  const [fecha, ...horaParts] = marcaTemporal.split(' ');\n  const hora = horaParts.join(' ') || '';\n\n  // Proveedor y cantidad mapeados desde campos originales\n  const proveedor = data['Que proveedor?'] || data['¿Que proveedor?'] || '';\n  const cantidad = data['Cuantas cintas vas a reportar de entrada?'] \n                || data['Cuantas cintas vas a reportar de salida?'] \n                || 0;\n\n  // Tipo de cinta normalizado\n  const tipoCintaRaw = data['Cinta Resellable o de Seguridad?'] || '';\n  let tipoCinta = '';\n  const tipoCintaLower = tipoCintaRaw.toLowerCase();\n  if (tipoCintaLower === 'seguridad') {\n    tipoCinta = 'Seguridad';\n  } else if (tipoCintaLower === 'resellable') {\n    tipoCinta = 'Resellable';\n  } else if (tipoCintaRaw) {\n    tipoCinta = tipoCintaRaw;\n  }\n\n  return {\n    json: {\n      'key' : data.row_number,\n      'Fecha de Movimiento': fecha,\n      'Hora Movimiento': hora,\n      'Tipo de Movimiento': tipoMovimiento,\n      'Proveedor': proveedor,\n      'Cantidad': cantidad,\n      '¿Quien Reporta?': data['¿Quién Reporta?'] || data['¿Quien Reporta?'] || '',\n      'tipo_cinta': tipoCinta,\n      'Ingresar Inventario' : ingresarInventario\n    }\n  };\n});\n\nreturn resultados;"
      },
