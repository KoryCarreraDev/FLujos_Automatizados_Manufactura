        "jsCode": "const staticData = $getWorkflowStaticData('global');\nlet stock = staticData.stockResellable ?? 0;\n\n// Iteramos por TODOS los registros entrantes\nconst resultados = $input.all().map(item => {\n  const data = item.json;\n  const cantidad = Number(data.Cantidad) || 0;\n  const tipo = data[\"Tipo de Movimiento\"];\n\n  if (tipo === 'Ingreso') {\n    stock += cantidad;\n  } else if (tipo === 'Egreso') {\n    stock -= cantidad;\n  }\n\n  return {\n    json: {\n      ...data,\n      \"Stock Restante\": stock\n    }\n  };\n});\n\n// Guardamos el stock final acumulado en la variable global estática\nstaticData.stockResellable = stock;\n\nreturn resultados;"
      },
