    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\n// Obtenemos la última fila si existe\nconst lastRow = rows.length > 0 ? rows[rows.length - 1] : null;\n\n// Extraemos el valor numérico de la columna \"Stock Restante\" de esa última fila\nconst lastStock = lastRow ? Number(lastRow[\"Stock Restante\"]) || 0 : 0;\n\n// Guardamos el stock real en la memoria del flujo\n$getWorkflowStaticData('global').stockSeguridad = lastStock;\n\nreturn [{ json: { init: true } }];"
      },
